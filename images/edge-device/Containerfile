# Mill edge device: RHEL bootc + podman-compose + the Flight Control agent.
# The agent syncs the mill-edge app into /etc/mill-edge, and mill-edge.service runs it.
# Build from the repo root:
#   podman build --platform=linux/amd64 -f images/edge-device/Containerfile -t quay.io/<you>/mill-edge-device:0.1.0 .
FROM registry.redhat.io/rhel9/rhel-bootc:latest

# podman-compose comes from EPEL; install it, then remove the EPEL repo
RUN dnf -y install https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm && \
    dnf -y install podman-compose && \
    dnf -y remove epel-release && \
    dnf clean all && rm -rf /var/cache/dnf /var/log/dnf*

# Flight Control agent and CLI from the upstream COPR. The package also masks bootc's own
# update timer, since the agent manages OS updates.
RUN curl -fsSL -o /etc/yum.repos.d/flightctl.repo \
      https://copr.fedorainfracloud.org/coprs/g/redhat-et/flightctl/repo/rhel-9/group_redhat-et-flightctl-rhel-9.repo && \
    dnf -y install flightctl-agent flightctl-cli firewalld policycoreutils && \
    dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* && \
    systemctl enable flightctl-agent.service

# The mill-edge app, restarted by the agent whenever its files change
COPY images/edge-device/mill-edge.service /usr/lib/systemd/system/mill-edge.service
COPY images/edge-device/mill-edge-hook.yaml /etc/flightctl/hooks.d/afterupdating/90-mill-edge.yaml
RUN systemctl enable mill-edge.service

RUN bootc container lint
