# "Modelcar" image: the trained model packaged as a signed, versioned OCI artifact.
# The edge pulls it like any other image, so the same signing and GitOps flow applies to models.
# Build from the repo root after `make train`:
#   podman build -f edge/Containerfile.model -t quay.io/<you>/bearing-model:1 .
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
COPY models/bearing /models/bearing
USER 1001
